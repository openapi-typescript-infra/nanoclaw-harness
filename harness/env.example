DEFAULT_AGENT_PROVIDER=codex
NANOCLAW_GATEWAY_PROVIDER=onecli
NANOCLAW_TEMPLATES_DIR=/opt/nanoclaw/harness/generated/templates
TZ=America/New_York
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Fill these with the values produced by gateway setup. The coordinator
# cannot reach the host's gateway at localhost; use a reachable private URL.
ONECLI_URL=
ONECLI_API_KEY=
ONECLI_GATEWAY_CONTAINER=onecli
# Deliberately no OPENAI_API_KEY / ANTHROPIC_API_KEY fallback.
